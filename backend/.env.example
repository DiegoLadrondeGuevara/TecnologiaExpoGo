# ── Base de datos ──
DATABASE_URL=postgresql://user:password@localhost:5432/techstore?schema=public

# ── JWT ──
JWT_SECRET=your-jwt-secret-here

# ── Servidor ──
PORT=3001

# ── Mercado Pago ──
# Sandbox (testing): usa TEST-xxx tokens del panel de desarrolladores
# Producción: usa APP_USR-xxx tokens del panel de desarrolladores
MP_ACCESS_TOKEN=APP_USR-xxxx-xxxx
MP_PUBLIC_KEY=APP_USR-xxxx-xxxx
MP_WEBHOOK_URL=https://tu-dominio-publico.com/payments/webhook

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
